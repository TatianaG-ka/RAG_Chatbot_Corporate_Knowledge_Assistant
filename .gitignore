# Environment files (if you are using dotenv locally)
# opcjonalnie: szablon bez sekretów (komentarz MUSI być w osobnej linii —
# .gitignore nie obsługuje komentarzy inline, inaczej negacja nie działa)
.env
.env.*
!.env.example

# IDE 
# PyCharm / IntelliJ
.idea/
# VS Code
.vscode/

# Other package managers (if you don't use one)
Pipfile
Pipfile.lock
poetry.lock

# FAISS demo index — rebuilt at cold-start from ./assets/, never committed
# (pickle format drifts across dep versions and breaks on HF runtime bumps —
# see README ADR-4). Keep the folder off-repo; rebuild is deterministic.
vectorstore/default_company/
